# Doxyfile
#
# Doxygen 1.9 以降の設定. 標準と異なる項目だけを書く.
# 生成: docker compose run --rm docs-thermo   (出力: docs/index.html。アプリごとに、docs/<アプリ>/html)
#   Markdown の注意: 日本語の直後に、"." か "(" で始まるコード (`.c` など) を続けると、Doxygen が誤る。空白を 1 つ入れる.
#   アプリごとに実行する (C には名前空間がなく、両方に ble_init() があるので、1 回では混ざる).
#   DOCS_NAME (プロジェクト名) と DOCS_APP (thermo-node か thermo-gateway) は、scripts/docs.sh が設定する.
#   Doxygen と Graphviz (図) は, Docker イメージに入っている.
#   警告 (ドキュメントのない関数や引数、書式の誤り) が 1 つでもあれば、scripts/docs.sh が失敗する.

PROJECT_NAME           = "$(DOCS_NAME)"
PROJECT_BRIEF          = "XIAO ESP32C3 の BLE 温度計と、AWS IoT Core へ送るゲートウェイ"
OUTPUT_DIRECTORY       = ./docs/$(DOCS_APP)
OUTPUT_LANGUAGE        = Japanese
INPUT_ENCODING         = UTF-8
TAB_SIZE               = 4
OPTIMIZE_OUTPUT_FOR_C  = YES
INPUT                  = README.md \
                         SETUP.md \
                         SIMULATION.md \
                         NATIVE_SIM_IMPLEMENTATION.md \
                         AWS_SETUP.md \
                         DEBUG_LOG.md \
                         AWS_GRAPH.md \
                         CODING_STYLE.md \
                         MISRA.md \
                         TODO.md \
                         .claude/CLAUDE.md \
                         app/common \
                         app/$(DOCS_APP)
FILE_PATTERNS          = *.c \
                         *.h \
                         *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = README.md
IMAGE_PATH              = assets
ENABLE_PREPROCESSING   = YES
# ビルド構成 (Kconfig) と、Zephyr のマクロ (関数に見えてしまうもの) の扱い
PREDEFINED             = CONFIG_THERMO_CLOUD \
                         CONFIG_THERMO_RTC \
                         CONFIG_MQTT_LIB_TLS \
                         "DEFINE_FFF_GLOBALS=" \
                         "FAKE_VALUE_FUNC(...)=" \
                         "FAKE_VOID_FUNC(...)=" \
                         "LOG_MODULE_REGISTER(...)=" \
                         "DEVICE_DT_INST_DEFINE(...)=" \
                         "DEVICE_API(type,name)=struct sensor_driver_api name" \
                         "K_SEM_DEFINE(name,...)=struct k_sem name;" \
                         "K_MSGQ_DEFINE(name,...)=struct k_msgq name;" \
                         "K_THREAD_STACK_DEFINE(name,size)=char name[size];" \
                         "K_WORK_DELAYABLE_DEFINE(name,...)=struct k_work_delayable name;" \
                         "BUILD_ASSERT(...)=" \
                         "SHELL_STATIC_SUBCMD_SET_CREATE(name,...)=const struct shell_static_entry name[];" \
                         "SHELL_CMD_REGISTER(...)=" \
                         "ZTEST(suite,name)=void suite##_##name(void)" \
                         "ZTEST_SUITE(...)="
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = YES
SOURCE_BROWSER         = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
GENERATE_TODOLIST      = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
# 警告の判定は、scripts/docs.sh が行う (日本語の出力に対する、Doxygen 本体の警告 "output language
# has not been updated" を、除くため)
WARN_AS_ERROR          = NO
WARN_LOGFILE           = ./docs/$(DOCS_APP)/doxygen-warnings.log
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = NO
HAVE_DOT               = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = NO
INCLUDE_GRAPH          = YES
DIRECTORY_GRAPH        = YES
DOT_CLEANUP            = YES
