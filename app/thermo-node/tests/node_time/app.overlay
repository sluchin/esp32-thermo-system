/* 偽の I2C コントローラ (vnd,test-i2c) に, PCF8563 (0x51) をつなぎ, alias thermo-rtc に接続する */
/ {
	aliases {
		thermo-rtc = &test_rtc;
	};

	test_i2c: test-i2c {
		compatible = "vnd,test-i2c";
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;

		test_rtc: pcf8563@51 {
			compatible = "nxp,pcf8563";
			reg = <0x51>;
			status = "okay";
		};
	};
};
