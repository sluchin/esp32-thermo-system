mainmenu "Thermo application"

config SIMULATOR
    bool "Build in simulator mode"
    help
      Use simulated sensor data and log simulator mode at startup.

config THERMO_ADC_MV_PER_DEG
    int "ADC temperature sensor: millivolts per degree Celsius"
    default 10
    range 1 1000
    help
      Used only when the temperature is read from an ADC channel
      (io-channels of zephyr,user). The default is for LM35
      (10 mV per degree Celsius).

config THERMO_ADC_OFFSET_MV
    int "ADC temperature sensor: voltage at 0 degrees Celsius [mV]"
    default 0
    range -2000 2000
    help
      Used only when the temperature is read from an ADC channel.
      The default is for LM35 (0 mV at 0 degrees Celsius).

config THERMO_DISPLAY
    bool "Show the temperature and the humidity on the OLED display"
    default y if $(dt_alias_enabled,thermo-display)
    select DISPLAY
    select CHARACTER_FRAMEBUFFER
    help
      Show the measured values on the OLED display (SSD1306, 128x64) of
      the Seeed Studio XIAO expansion board (Devicetree alias
      thermo-display). The default is y when the alias exists.
      Set n (-DCONFIG_THERMO_DISPLAY=n) to build without the display.

config THERMO_DISPLAY_TIMEOUT_SEC
    int "Turn off the OLED display after this many seconds (0: always on)"
    default 10
    range 0 3600
    depends on THERMO_DISPLAY
    help
      The OLED display is turned on when the node starts and when the
      user button (D1) is pressed, and it is turned off after this many
      seconds without a button press. The button press that wakes the
      display does not switch the page. Set 0 to keep the display on.

config THERMO_BOOT_SCREEN
    bool "Show the boot animation on the OLED display"
    default y
    depends on THERMO_DISPLAY
    help
      Show an animation (a round character eating dots, chased by an
      enemy) and the title for about 3 seconds when the node starts.
      The pictures are defined in boot_assets.c.

config THERMO_BUZZER
    bool "Play the boot sound with the buzzer of the expansion board"
    default y if $(dt_alias_enabled,thermo-buzzer)
    select PWM
    help
      Play a short melody with the passive buzzer of the Seeed Studio
      XIAO expansion board (D3, PWM of the LEDC) when the node starts.
      The melody is defined in boot_assets.c. The default is y when the
      Devicetree alias thermo-buzzer exists.

config THERMO_BUTTON_SOUND
    bool "Play a sound with the buzzer when the button is pressed"
    default y
    depends on THERMO_BUZZER && THERMO_DISPLAY
    help
      Play a short sound with the buzzer when the user button (D1) is
      pressed. The button switches the pages of the OLED display, so this
      depends on THERMO_DISPLAY. The sound is defined in button_assets.c.
      If app/thermo-node/private/src/button_assets.c exists, it is used
      instead (a private repository can be put there as a submodule).

config THERMO_RTC
    bool "Keep the time with the RTC (PCF8563) of the expansion board"
    default y if $(dt_alias_enabled,thermo-rtc)
    select I2C
    select RTC
    help
      Read the time from the RTC (PCF8563, Devicetree alias thermo-rtc)
      and show it on the OLED display. The RTC driver of this
      application (drivers/rtc_pcf8563.c, compatible thermo,pcf8563) is
      used, because the driver of Zephyr v4.3 does not handle the month
      and the year as the chip does. The default is y when the alias
      exists. Set n (-DCONFIG_THERMO_RTC=n) to build without the RTC.

config THERMO_UTC_OFFSET_MIN
    int "Offset of the local time from UTC [minutes]"
    default 540
    range -720 840
    depends on THERMO_RTC
    help
      The RTC keeps UTC. The OLED display shows the local time, which is
      UTC plus this offset. The default is 540 (UTC+9, Japan Standard
      Time).

config THERMO_WIFI_TIME
    bool "Get the time over WiFi when BLE does not give it"
    default y
    depends on THERMO_RTC
    help
      When the RTC has no time for 5 minutes (the gateway has not sent
      the time over BLE), connect to WiFi, get the time with SNTP, set
      the RTC and disconnect WiFi at once. WiFi is not used while the
      RTC has the time. The SSID and the password are entered with the
      "thermo" shell command (thermo set ssid ..., thermo set psk ...).

config THERMO_NTP_SERVER
    string "NTP server host name"
    default "pool.ntp.org"
    depends on THERMO_WIFI_TIME
    help
      The SNTP server that is asked for the time over WiFi.

config THERMO_NTP_RESYNC_SEC
    int "Minimum interval between two time synchronizations [s]"
    default 3600
    depends on THERMO_WIFI_TIME
    help
      Used when the node sends directly to AWS IoT Core over WiFi: after
      a successful synchronization, the next one is skipped until this
      many seconds have passed (it is tried at each WiFi connection).

config THERMO_DIRECT_MQTT
    bool "Send directly to AWS IoT Core over WiFi when the gateway is not connected"
    default y
    depends on THERMO_WIFI_TIME
    help
      When BLE is not connected to the gateway for 5 samples in a row,
      connect to WiFi and publish the temperature to AWS IoT Core with
      MQTT over TLS every 10 seconds. When the gateway connects again,
      stop and disconnect WiFi. If the WiFi or the MQTT connection fails
      5 times, give up until the gateway connects once more. The settings
      (SSID, password, endpoint, client ID, certificates) are entered with
      the "thermo" shell command, as for the gateway. Use a certificate and
      a client ID of its own for each node.

config THERMO_BACKLOG
    bool "Save the values on the SD card, and send them later"
    default y if $(dt_nodelabel_enabled,sdhc0)
    depends on THERMO_DIRECT_MQTT
    select DISK_ACCESS
    select FILE_SYSTEM
    select FAT_FILESYSTEM_ELM
    select CRC
    help
      Save every measurement (UNIX time, temperature, humidity and a
      "sent" flag) on the SD card of the expansion board (FAT, SPI).
      The values measured while BLE is connected to the gateway are
      saved as sent (the gateway sends them). The values measured while
      neither BLE nor WiFi is connected are saved as not sent, and sent
      to AWS IoT Core in the order of the time with MQTT when the
      gateway or WiFi is available again. The default is y when the SD
      card is in the Devicetree (the node label sdhc0). The card must be
      formatted with FAT.

config THERMO_BACKLOG_MAX_RECORDS
    int "Maximum number of the values on the SD card"
    default 100000
    range 10 4000000
    depends on THERMO_BACKLOG
    help
      One value takes 16 bytes. The file is a ring of this many values:
      when it is full, the oldest values are overwritten. The default
      100000 is about 1.6 MB, and about 5.8 days of the values saved
      every 5 seconds. The file is read once at the start (a few
      seconds for the default).

config THERMO_BACKLOG_MOUNT
    string "Mount point of the SD card"
    default "/SD:"
    depends on THERMO_BACKLOG
    help
      The FatFS volume name is the disk name of the Devicetree (SD).

config THERMO_GRAPH_STEP_SEC
    int "Time per point of the graph on the OLED display [seconds]"
    default 170
    range 5 600
    depends on THERMO_DISPLAY
    help
      The graph pages of the OLED display (temperature and humidity)
      show the last 128 points, one point per this time (the average of
      the measurements in the time). The default 170 shows the last 6
      hours. 30 shows 64 minutes.

config THERMO_HISTORY_STORE
    bool "Restore the graph history from the SD card"
    default y
    depends on THERMO_BACKLOG && THERMO_DISPLAY && THERMO_RTC
    help
      When the node starts and the RTC has the time, rebuild the points
      of the graph (the average of the temperature and the humidity in a
      time step) from the records on the SD card, which are saved for
      every measurement. The time while the node was off is shown as a
      gap in the graph.

source "Kconfig.zephyr"
