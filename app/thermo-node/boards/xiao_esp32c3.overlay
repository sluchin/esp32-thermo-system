/*
 * 温湿度センサと気圧センサの接続 (XIAO ESP32C3)
 *
 * AHT20 + BMP280 のモジュール (4 ピン: VCC / GND / SDA / SCL. DC 2.8 V から 5 V) を, 拡張ボードの
 * I2C (Grove の I2C のコネクタ. D4 が SDA, D5 が SCL) につなぐ (VCC は 3V3).
 *   AHT20 (温度と湿度. I2C のアドレスは 0x38) は alias thermo-sensor で使う (Zephyr の aosong,aht20
 *   のドライバ).
 *   BMP280 (気圧. I2C のアドレスは 0x77) は alias thermo-pressure で使う (Zephyr の bosch,bme280 の
 *   ドライバ. チップの ID で, BMP280 として動く). モジュールによっては 0x76 なので, 起動のログに
 *   Pressure sensor is not ready が出たら, bmp280 のノードの reg と, ノードの名前を 0x76 にする.
 * 温度は AHT20 の値を使う (BMP280 の温度は使わない). BMP280 が使えないときも, 温度と湿度は送る
 * (気圧なし).
 *
 * DHT11 (3 ピンのモジュール) に替えるときは, app/thermo-node/sensors/dht11.overlay を足して
 * ビルドする (THERMO_SENSOR=dht11 docker compose run --rm build-node. SETUP.md).
 *
 * ADC のアナログセンサ (LM35 など) に替えるときはこのファイルの aliases の thermo-sensor と
 * thermo-pressure と, aht20 と bmp280 のノードを消して, zephyr,user に io-channels を書く
 * (ADC のチャンネルの設定も要る. 例は app/thermo-node/tests/sensor/adc.overlay). 温度への換算は
 * CONFIG_THERMO_ADC_MV_PER_DEG と CONFIG_THERMO_ADC_OFFSET_MV で設定する (prj.conf).
 *
 * OLED (拡張ボードの SSD1306. I2C のアドレスは 0x3C. D4 が SDA, D5 が SCL) は alias
 * thermo-display で使う. 使わないときは CONFIG_THERMO_DISPLAY=n でビルドする (prj.conf または
 * -DCONFIG_THERMO_DISPLAY=n). ノードの設定は Zephyr の seeed_xiao_expansion_board のシールドと
 * 同じ (シールドは SD カードの SPI も有効にするので, 使わない).
 *
 * ブザー (拡張ボードのパッシブブザー. D3 = GPIO5) は alias thermo-buzzer で使う. PWM (LEDC のチャンネル
 * 0) の周波数が音の高さになる. 起動のときの, 短いメロディを鳴らす (CONFIG_THERMO_BUZZER=n のときは
 * 使わない). PWM の周期は鳴らすときに, 音ごとに, 設定する (ここの値は使わない).
 *
 * ボタン (拡張ボードのユーザボタン. D1 = GPIO3. 押すと, 0 になる) は alias thermo-button で使い,
 * OLED の画面を切り替える (CONFIG_THERMO_DISPLAY=n のときは使わない).
 *
 * RTC (拡張ボードの PCF8563. I2C のアドレスは 0x51) は alias thermo-rtc で使う. Zephyr の RTC
 * ドライバ (nxp,pcf8563) は月と年の扱いがチップと合わないので使わず, このアプリのドライバ
 * (drivers/rtc_pcf8563.c. compatible は thermo,pcf8563) を使う. 使わないときは
 * CONFIG_THERMO_RTC=n でビルドする.
 */
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
    aliases {
        thermo-sensor = &aht20;
        thermo-pressure = &bmp280;
        thermo-display = &ssd1306_128x64;
        thermo-rtc = &pcf8563_rtc;
        thermo-button = &thermo_button;
        thermo-buzzer = &thermo_buzzer;
    };

    thermo_buzzer: pwm-buzzer {
        compatible = "thermo,buzzer";
        pwms = <&ledc0 0 PWM_HZ(1000) PWM_POLARITY_NORMAL>;
    };

    buttons {
        compatible = "gpio-keys";

        thermo_button: button_0 {
            gpios = <&xiao_d 1 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
        };
    };
};

&xiao_i2c {
    status = "okay";

    ssd1306_128x64: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <64>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        segment-remap;
        com-invdir;
        prechargep = <0x22>;
    };

    pcf8563_rtc: pcf8563@51 {
        compatible = "thermo,pcf8563";
        reg = <0x51>;
        status = "okay";
    };

    aht20: aht20@38 {
        compatible = "aosong,aht20";
        reg = <0x38>;
        status = "okay";
    };

    bmp280: bmp280@77 {
        compatible = "bosch,bme280";
        reg = <0x77>;
        status = "okay";
    };
};

&pinctrl {
    ledc0_default: ledc0_default {
        group1 {
            pinmux = <LEDC_CH0_GPIO5>;
            output-enable;
        };
    };
};

&ledc0 {
    pinctrl-0 = <&ledc0_default>;
    pinctrl-names = "default";
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    channel0@0 {
        reg = <0x0>;
        timer = <0>;
    };
};

/*
 * SD カード (拡張ボードの, SPI の SD カードスロット. CS は D2) は送れなかった測定値を溜めるために使う
 * (CONFIG_THERMO_BACKLOG). Zephyr の seeed_xiao_expansion_board のシールドと同じ設定 (SPI は XIAO の
 * D8 が SCK, D9 が MISO, D10 が MOSI). ディスク名は SD (マウントポイント /SD:).
 */
&xiao_spi {
    status = "okay";
    cs-gpios = <&xiao_d 2 GPIO_ACTIVE_LOW>;

    sdhc0: sdhc@0 {
        compatible = "zephyr,sdhc-spi-slot";
        reg = <0>;
        status = "okay";

        mmc {
            compatible = "zephyr,sdmmc-disk";
            disk-name = "SD";
            status = "okay";
        };
        spi-max-frequency = <24000000>;
    };
};
