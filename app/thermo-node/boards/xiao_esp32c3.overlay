/*
 * 温湿度センサの接続 (XIAO ESP32C3)
 *
 * DHT11 (3 ピンのモジュール: + / out / -) を, 次のようにつなぐ.
 *   +   -> 3V3
 *   out -> D7 (GPIO20. 拡張ボードの, 下側のヘッダの RX'7)
 *   -   -> GND
 * D7 は, 起動時に, 信号が出ない (D6 は, ROM のログが出る. D8 と D9 は, ストラッピングのピン).
 * DHT22 (AM2303) を使うときは, dht11 のノードに, dht22; を足す.
 *
 * ADC のアナログセンサ (LM35 など) に替えるときは, このファイルの aliases と dht11 のノードを
 * 消して, zephyr,user に io-channels を書く (ADC のチャンネルの設定も要る. 例は
 * app/thermo-node/tests/sensor/adc.overlay). 温度への換算は, CONFIG_THERMO_ADC_MV_PER_DEG と
 * CONFIG_THERMO_ADC_OFFSET_MV で設定する (prj.conf).
 *
 * OLED (拡張ボードの SSD1306. I2C のアドレスは 0x3C. D4 が SDA, D5 が SCL) は, alias
 * thermo-display で使う. 使わないときは, CONFIG_THERMO_DISPLAY=n でビルドする (prj.conf または
 * -DCONFIG_THERMO_DISPLAY=n). ノードの設定は, Zephyr の seeed_xiao_expansion_board のシールドと
 * 同じ (シールドは, SD カードの SPI も有効にするので, 使わない).
 *
 * ボタン (拡張ボードのユーザボタン. D1 = GPIO3. 押すと, 0 になる) は, alias thermo-button で使い,
 * OLED の画面を切り替える (CONFIG_THERMO_DISPLAY=n のときは, 使わない).
 *
 * RTC (拡張ボードの PCF8563. I2C のアドレスは 0x51) は, alias thermo-rtc で使う. Zephyr の RTC
 * ドライバ (nxp,pcf8563) は, 月と年の扱いがチップと合わないので使わず, このアプリのドライバ
 * (drivers/rtc_pcf8563.c. compatible は thermo,pcf8563) を使う. 使わないときは,
 * CONFIG_THERMO_RTC=n でビルドする.
 */
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
    aliases {
        thermo-sensor = &dht11;
        thermo-display = &ssd1306_128x64;
        thermo-rtc = &pcf8563_rtc;
        thermo-button = &thermo_button;
    };

    buttons {
        compatible = "gpio-keys";

        thermo_button: button_0 {
            gpios = <&xiao_d 1 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
        };
    };

    dht11: dht11 {
        compatible = "aosong,dht";
        status = "okay";
        dio-gpios = <&xiao_d 7 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>;
    };
};

&xiao_i2c {
    status = "okay";

    ssd1306_128x64: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <64>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        segment-remap;
        com-invdir;
        prechargep = <0x22>;
    };

    pcf8563_rtc: pcf8563@51 {
        compatible = "thermo,pcf8563";
        reg = <0x51>;
        status = "okay";
    };
};
