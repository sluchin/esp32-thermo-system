mainmenu "Thermo application"

config SIMULATOR
	bool "Build in simulator mode"
	help
	  Use simulated sensor data and log simulator mode at startup.

config THERMO_CLOUD
	bool "Send temperatures to AWS IoT Core over WiFi and MQTT"
	default y
	help
	  Connect to WiFi and publish the temperatures received from the nodes
	  to AWS IoT Core with MQTT over TLS. The settings (WiFi, endpoint,
	  certificates) are entered with the "thermo" shell command.
	  Disable it for builds without a network (native_sim).

config THERMO_SWITCHBOT_INTERVAL_MS
	int "Minimum interval between two reports of one SwitchBot device [ms]"
	default 1000
	help
	  The SwitchBot Outdoor Meter broadcasts its temperature in every
	  advertisement. A reading of one device is reported at most once
	  in this interval.

source "Kconfig.zephyr"
